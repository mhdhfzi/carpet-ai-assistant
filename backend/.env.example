# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=local
DEBUG=false
DATABASE_URL=postgresql+psycopg://carpet:carpet@127.0.0.1:5432/carpet
# Sites allowed to embed the chat widget (comma-separated), e.g. https://demo.example.com
CORS_ORIGINS=

# Voyage AI (embeddings): https://dash.voyageai.com/
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5

# Anthropic (Claude): https://console.anthropic.com/
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
